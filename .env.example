# Copie para .env. Nunca publique este arquivo preenchido ou compartilhe a chave.
APP_PASSWORD=1309
HOST=127.0.0.1
PORT=4173
# Em produção, origem HTTPS pública exata, sem barra final:
# NODE_ENV=production
# APP_ORIGIN=https://seu-editor.exemplo.com

# Preencha todos os três para ativar o Supabase. A chave fica somente no servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Um UUID fixo para esta biblioteca. Gere com: node -p "crypto.randomUUID()"
PRESET_LIBRARY_ID=

# Sem Supabase, desenvolvimento salva em .runtime/presets.json (não sincroniza).
# Produção exige Supabase configurado.
