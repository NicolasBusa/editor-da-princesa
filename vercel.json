{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["gru1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{*.html,*.css,*.js,assets/**,cameraProfiles/**,filmEngine/**}",
      "maxDuration": 20
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
